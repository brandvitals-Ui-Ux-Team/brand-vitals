{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/app/index.html"
    },
    {
      "source": "/crew",
      "destination": "/crew/index.html"
    },
    {
      "source": "/crew/:path*",
      "destination": "/crew/index.html"
    },
    {
      "source": "/jobs",
      "destination": "/jobs/index.html"
    },
    {
      "source": "/jobs/:path*",
      "destination": "/jobs/index.html"
    }
  ],
  "functions": {
    "api/inspect.js": {
      "maxDuration": 15
    },
    "api/psi.js": {
      "maxDuration": 60
    },
    "api/connect.js": {
      "maxDuration": 30
    },
    "api/sync.js": {
      "maxDuration": 30
    },
    "api/ads.js": {
      "maxDuration": 20
    },
    "api/pay.js": {
      "maxDuration": 20
    },
    "api/ai.js": {
      "maxDuration": 60
    },
    "api/cron.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' blob: https://www.googletagmanager.com https://www.clarity.ms https://*.clarity.ms https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.github.com https://www.googleapis.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://*.clarity.ms https://www.facebook.com https://connect.facebook.net; frame-src 'self' https://www.google.com https://www.youtube-nocookie.com https://www.youtube.com https://player.vimeo.com https://www.loom.com https://www.figma.com https://embed.figma.com https://drive.google.com https://docs.google.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/app/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/crew/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/crew/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/jobs/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/jobs/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/live.html",
      "destination": "/stage.html",
      "permanent": true
    },
    {
      "source": "/hq.html",
      "destination": "/go.html",
      "permanent": true
    },
    {
      "source": "/ar/live.html",
      "destination": "/ar/stage.html",
      "permanent": true
    },
    {
      "source": "/ar/hq.html",
      "destination": "/ar/go.html",
      "permanent": true
    },
    {
      "source": "/approve.html",
      "destination": "/go.html",
      "permanent": true
    },
    {
      "source": "/ar/approve.html",
      "destination": "/ar/go.html",
      "permanent": true
    },
    {
      "source": "/approve",
      "destination": "/go.html",
      "permanent": true
    },
    {
      "source": "/studio.html",
      "destination": "/frames.html",
      "permanent": true
    },
    {
      "source": "/ar/studio.html",
      "destination": "/ar/frames.html",
      "permanent": true
    },
    {
      "source": "/events.html",
      "destination": "/stage.html",
      "permanent": true
    },
    {
      "source": "/ar/events.html",
      "destination": "/ar/stage.html",
      "permanent": true
    },
    {
      "source": "/recruit.html",
      "destination": "/jobs.html",
      "permanent": true
    },
    {
      "source": "/ar/recruit.html",
      "destination": "/ar/jobs.html",
      "permanent": true
    },
    {
      "source": "/recruit/jobs/:id",
      "destination": "/jobs/view/:id",
      "permanent": true
    },
    {
      "source": "/recruit/jobs",
      "destination": "/jobs/search",
      "permanent": true
    },
    {
      "source": "/recruit/:path*",
      "destination": "/jobs/:path*",
      "permanent": true
    },
    {
      "source": "/recruit",
      "destination": "/jobs/",
      "permanent": true
    },
    {
      "source": "/frames",
      "destination": "/frames.html",
      "permanent": false
    },
    {
      "source": "/web",
      "destination": "/web.html",
      "permanent": false
    },
    {
      "source": "/stage",
      "destination": "/stage.html",
      "permanent": false
    },
    {
      "source": "/go",
      "destination": "/go.html",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 6 * * *"
    }
  ]
}
