{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/app/index.html"
    },
    {
      "source": "/crew",
      "destination": "/crew/index.html"
    },
    {
      "source": "/crew/:path*",
      "destination": "/crew/index.html"
    },
    {
      "source": "/recruit",
      "destination": "/recruit/index.html"
    },
    {
      "source": "/recruit/:path*",
      "destination": "/recruit/index.html"
    }
  ],
  "functions": {
    "api/inspect.js": {
      "maxDuration": 15
    },
    "api/psi.js": {
      "maxDuration": 60
    },
    "api/connect.js": {
      "maxDuration": 30
    },
    "api/sync.js": {
      "maxDuration": 30
    },
    "api/ads.js": {
      "maxDuration": 20
    },
    "api/pay.js": {
      "maxDuration": 20
    },
    "api/ai.js": {
      "maxDuration": 60
    },
    "api/cron.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/app/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/crew/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/crew/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/recruit/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/recruit/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/live.html",
      "destination": "/events.html",
      "permanent": true
    },
    {
      "source": "/hq.html",
      "destination": "/go.html",
      "permanent": true
    },
    {
      "source": "/ar/live.html",
      "destination": "/ar/events.html",
      "permanent": true
    },
    {
      "source": "/ar/hq.html",
      "destination": "/ar/go.html",
      "permanent": true
    },
    {
      "source": "/approve.html",
      "destination": "/go.html",
      "permanent": true
    },
    {
      "source": "/ar/approve.html",
      "destination": "/ar/go.html",
      "permanent": true
    },
    {
      "source": "/approve",
      "destination": "/go.html",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 6 * * *"
    }
  ]
}
