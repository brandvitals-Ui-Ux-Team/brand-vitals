{
  "name": "brand-vitals",
  "private": true,
  "version": "2.0.0",
  "description": "Brand Vitals website (static, bilingual) + Vitals Approve app",
  "type": "module",
  "workspaces": [
    "apps/hq"
  ],
  "scripts": {
    "build": "npm run build:hq && npm run build:site",
    "build:site": "node scripts/build-site.mjs",
    "build:hq": "npm run build --workspace apps/hq",
    "dev": "npm run build:site && node server.js",
    "dev:hq": "npm run dev --workspace apps/hq",
    "check": "node scripts/check-site.mjs",
    "test:db": "node supabase/tests/migration.test.mjs",
    "test": "npm run build && npm run check && npm run test:db && npm run test:api",
    "gen:pages": "node scripts/gen-pages.mjs",
    "test:api": "node --test api/tests/api.test.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "cheerio": "^1.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@supabase/supabase-js": "^2.117.3",
    "zod": "^4.6.5"
  }
}
