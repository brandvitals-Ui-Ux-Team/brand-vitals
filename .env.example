# Copy to apps/hq/.env.local for local development, or add in Vercel → Settings → Environment Variables.

# Vitals HQ database (Supabase → Project Settings → API). Leave empty for demo mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google PageSpeed Insights API key for the Vitals Score tool (server-side only).
PSI_API_KEY=

# Branded client emails from Vitals Approve (resend.com). Server-side only.
RESEND_API_KEY=
EMAIL_FROM=Vitals Approve <approvals@brandvitals.io>
