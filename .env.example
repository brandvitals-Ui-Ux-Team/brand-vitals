# Copy to apps/hq/.env.local for local development, or add in Vercel → Settings → Environment Variables.

# Vitals HQ database (Supabase → Project Settings → API). Leave empty for demo mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google PageSpeed Insights API key for the Vitals Score tool (server-side only).
PSI_API_KEY=

# Branded client emails from Vitals GO (resend.com). Server-side only.
RESEND_API_KEY=
EMAIL_FROM=Vitals GO <approvals@brandvitals.io>

# ---------- Server integrations (Vitals GO) ----------
# Required for any native integration: server access to Supabase + an encryption key for stored tokens.
SUPABASE_SERVICE_ROLE_KEY=
TOKEN_ENC_KEY=            # long random string, e.g. `openssl rand -base64 48`; never change it once tokens are stored
APP_URL=https://brandvitals.io
SYNC_SECRET=              # random string; also stored in public.app_config (see README)
CRON_SECRET=              # random string; Vercel Cron sends it automatically

# OAuth apps (create one per provider; redirect URL = https://<your domain>/api/connect?action=callback&provider=<name>)
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=

# AI (Claude) and voice-note transcription (ElevenLabs Scribe)
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
